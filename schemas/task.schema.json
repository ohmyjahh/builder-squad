{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://builder-squad.local/schemas/task.schema.json",
  "title": "Builder Squad Task Frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["task", "responsavel", "responsavel_type", "atomic_layer", "Entrada", "Saida", "Checklist"],
  "properties": {
    "task": { "type": "string", "minLength": 3 },
    "responsavel": { "type": "string", "pattern": "^@[a-z][a-z0-9-]+$" },
    "responsavel_type": { "const": "agent" },
    "atomic_layer": { "const": "task" },
    "Entrada": { "type": "string", "minLength": 3 },
    "Saida": { "type": "string", "minLength": 3 },
    "Checklist": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
