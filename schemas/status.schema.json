{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://builder-squad.local/schemas/status.schema.json",
  "title": "Builder Squad Project Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "state", "current_owner", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "type": "string" },
    "state": {
      "enum": ["NEW", "DISCOVERY", "CLASSIFIED", "BRIEFED", "VALIDATING", "PLANNED", "READY_FOR_EXECUTION", "IN_EXECUTION", "IN_REVIEW", "NEEDS_REVISION", "READY_FOR_RELEASE", "RELEASING", "ROLLING_BACK", "RELEASED", "MEASURING", "BLOCKED", "COMPLETE", "CANCELLED"]
    },
    "current_phase": { "type": ["string", "null"] },
    "current_task": { "type": ["string", "null"] },
    "current_owner": { "type": ["string", "null"] },
    "completed_tasks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "open_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "summary"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "summary": { "type": "string" }
        }
      }
    },
    "blocker": { "type": ["object", "null"] },
    "retry_count": { "type": "integer", "minimum": 0, "maximum": 2 },
    "latest_verdicts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quality": { "type": ["string", "null"] },
        "security": { "type": ["string", "null"] },
        "release": { "type": ["string", "null"] }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "condition": { "type": ["string", "null"] }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
